DRY_RUN=true
REAL_PUBLISHING=false
REVIEW_LEVEL=L0
DATABASE_URL=sqlite:///data/distribution_os.db
PLATFORM_READY_DIR=platform_ready
RULE_FRESHNESS_DAYS=30
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_SECONDS=3600
JOB_MAX_RETRIES=3
JOB_BASE_BACKOFF_SECONDS=30
HOST=127.0.0.1
PORT=8787

# Secrets are never placed here. Store real values outside Git and expose only
# environment variables referenced by Account.credential_reference.
